# Copy this file to .env for local development.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///socio_attendance.db
FLASK_ENV=development
FLASK_DEBUG=1
SESSION_COOKIE_SECURE=0
RATELIMIT_STORAGE_URI=memory://

# Restrict Host headers in deployed environments. Use a comma-separated list.
# Example: TRUSTED_HOSTS=attendance.example.com,www.attendance.example.com
# TRUSTED_HOSTS=localhost,127.0.0.1

# For HTTPS production deployments, use shared rate-limit storage (Redis recommended):
# FLASK_ENV=production
# FLASK_DEBUG=0
# SESSION_COOKIE_SECURE=1
# SECRET_KEY=<long-random-secret>
# DATABASE_URL=postgresql+psycopg://user:password@host/database
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# TRUSTED_HOSTS=attendance.example.com
